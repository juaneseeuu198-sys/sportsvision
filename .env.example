# ══ SportsVision — Variables de entorno ══════════════════════════════
# Copia este archivo como .env y rellena los valores reales.
# Para el .exe: pon este archivo al lado de SportsVision.exe

# ── Base de datos Railway PostgreSQL ─────────────────────────────────
DATABASE_URL=postgresql://postgres:CONTRASEÑA@tramway.proxy.rlwy.net:PUERTO/railway

# ── Correo Gmail (verificación y OTP) ────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sportsvisionmanager@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# ── URL pública de la app (para enlaces en correos) ───────────────────
FRONTEND_URL=https://web-production-f0f4b.up.railway.app
DEFAULT_FROM_EMAIL=SportsVision <sportsvisionmanager@gmail.com>
